additional_domain        = "additional-domain.com"
main_login_domain        = "main-domain.com"
tf_service_account_email = "tf-iam-admin@iam-seed-prod-01.iam.gserviceaccount.com"

# 1. 전사 기본 그룹 (상단 Organization Switcher 노출용 — 신규 조직 접근 전 임직원 포함)
gcp_users_members = [
  "cloud-admin@main-domain.com",
  "app-dev1@main-domain.com",
  "prj-admin1@main-domain.com",
]

# 2. 플랫폼 관리자 그룹 (하위 폴더 계층 관리 및 프로젝트 생성 권한 — Tier-0 분리를 위해 organizationAdmin 제외)
gcp_org_admins_members = [
  "cloud-admin@main-domain.com",
]

# 3. 앱 개발팀 그룹 (app-dev 폴더 최소 권한 조회 격리)
gcp_app_devs_members = [
  "app-dev1@main-domain.com",
]

# 4. 특정 프로젝트 전담 관리자 그룹 (권한 범위를 지정된 프로젝트 내부로만 한정한 Editor + Project IAM Admin)
gcp_prj_admins_members = [
  "prj-admin1@main-domain.com",
]

# 실제 생성된 워크로드 GCP Project ID 목록 (프로젝트 준비 후 주석 해제하여 등록)
gcp_prj_admins_project_ids = [
  # "app-dev-prj-01",
  # "app-dev-prj-02",
]
