# ==============================================================================
# GCP Minimal Organization Policies — Example Configuration
# ==============================================================================
# 사용 방법:
#   cp terraform.tfvars.example terraform.tfvars
#   (.gitignore에 의해 *.tfvars 및 imports.tf 파일은 Git 커밋에서 자동 제외됩니다.)
#
# 정책 티어별 관리 파일 안내:
# - baseline_policies.tf    : [Baseline 12종] 기본 보안 가드레일 (즉시 강제: spec)
# - audit_first_policies.tf : [Audit-First 7종] 사전 감사 정책 (초기: dry_run_spec -> 승격 시 spec 으로 변경)
# - opt_in_policies.tf      : [Opt-In 7종] 선택 적용 정책 (초기 주석 처리 -> 준비된 정책만 주석 해제)

# ------------------------------------------------------------------------------
# 1. 대상 조직 및 적용 범위 (Hands-On 폴더 실습 vs 프로덕션 Org Root 배포)
# ------------------------------------------------------------------------------
org_id = "123456789012" # 대상 GCP Organization의 숫자형 ID

# [권장 워크플로우]
# - Step 1 (Hands-On 실습 / 사전 검증): "folder" 로 설정하면 격리된 실습 폴더에만 정책이 부착되어
#   기존 워크로드 영향이나 루트 정책 409 충돌 없이 안전하게 차단·감사·예외 태그를 체험할 수 있습니다.
# - Step 2 (프로덕션 본 배포): 실습 완료 후 "organization" 으로 변경하고
#   ./scripts/generate-imports.sh --org <ORG_ID> 실행 뒤 안내에 따라 apply 하면 조직 루트에 배포됩니다.
policy_scope                = "folder"             # "folder" (실습/사전검증) | "organization" (조직 루트 본 배포)
target_folder_id            = ""                   # 기존 폴더에 적용할 때만 숫자 ID 입력 (비워두면 아래 이름으로 폴더 자동 생성)
handson_folder_display_name = "policy-handson-lab" # policy_scope = "folder" 시 자동 생성할 폴더 이름
create_env_folders          = false                # 표준 환경 폴더(Prod, Dev, Shared) 생성 여부

# ------------------------------------------------------------------------------
# 2. 도메인 제한(DRS), 중요 알림 도메인 및 신뢰 이미지 파라미터
# ------------------------------------------------------------------------------
# 보안·장애 중요 알림(Essential Contacts) 수신 허용 도메인 ('@' 시작 필수)
allowed_contact_domains = [
  "@example.com",
]

# 차세대 DRS(iam.managed.allowedPolicyMembers)에 현재 org_id 외 추가 허용할 외부 조직 ID
# - 단일 조직 격리 운영(또는 multi-org-group-iam 그룹 위임 패턴 사용) 시 빈 리스트([]) 권장
drs_allowed_org_ids         = []
drs_allowed_member_subjects = []

# 신뢰 부팅 이미지 소스 목록 (선택, Public Preview: 'projects/<PROJECT_NUMBER>' 또는 'organizations/<ORG_ID>')
trusted_image_projects = [
  # "organizations/123456789012",
  # "projects/136693071363", # debian-cloud 공식 프로젝트 번호 예시
]

# ------------------------------------------------------------------------------
# 3. 목적별 독립 예외 태그 및 선언적(Declarative) 태그 바인딩
# ------------------------------------------------------------------------------
tag_key_prefix = "exempt" # 공유 테스트 조직에서 기존 태그와 이름 충돌 시 "lab-exempt" 등으로 변경 가능

# 지원되는 8종 예외 키:
# "sa_key" | "public_iam" | "public_storage" | "external_ip" | "public_sql" | "os_login" | "trusted_image" | "serverless"

# (권장) 프로젝트 단위 예외 태그 바인딩 — 모든 제약조건(.managed. 및 레거시 Opt-In 전체)에서 상속 동작
project_tag_exemptions = {
  # "my-public-assets-prod" = ["public_storage"]
  # "legacy-partner-sync"   = ["sa_key"]
}

# (선택) 개별 리전/존 서비스 리소스 정밀 예외 태그 바인딩 — .managed. 제약조건 전용!
# 주의: storage.publicAccessPrevention, run.allowedIngress 등 레거시(Opt-In) 제약조건은
#       하위 리소스 직접 태그를 평가하지 않으므로 반드시 위 project_tag_exemptions를 사용하세요.
regional_resource_tag_exemptions = [
  # {
  #   parent    = "//run.googleapis.com/projects/my-app-prod/locations/asia-northeast3/services/public-webhook"
  #   location  = "asia-northeast3"
  #   exemption = "serverless" # run.managed.requireInvokerIam 예외 허용
  # }
]

# ------------------------------------------------------------------------------
# 4. (선택) 타 조직 프로젝트 반입 허용 & Keyless SA Impersonation
# ------------------------------------------------------------------------------
# 타 GCP Organization에서 프로젝트/폴더를 이관해 올 때만 원본 Org ID를 입력 (이관 불필요/완료 시 [])
allowed_import_source_org_ids = []

# 프로덕션 환경(또는 iam/multi-org-group-iam 연계 시) Keyless SA Impersonation 설정
# tf_service_account_email = "tf-iam-admin@iam-seed-prod-01.iam.gserviceaccount.com"
# billing_project_id       = "iam-seed-prod-01"
